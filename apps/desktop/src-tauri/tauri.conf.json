{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klipzo",
  "version": "0.1.0",
  "identifier": "app.klipzo.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @klipzo/web dev",
    "beforeBuildCommand": "pnpm --filter @klipzo/web build"
  },
  "app": {
    "windows": [{ "title": "Klipzo", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
